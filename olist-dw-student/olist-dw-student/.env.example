# Copy this file to .env (same folder as the Dockerfile) and restart: astro dev restart
#
# 1) Enables the "Test" button in Admin > Connections
AIRFLOW__CORE__TEST_CONNECTION=Enabled

# 2) DAG file import timeout. Cosmos reads the whole dbt project on every parse:
#    30 s (the default) is not enough once the project grows. The log line
#      "DagBag import timeout for .../dbt_olist.py"
#    means this value is too small, or that a .venv / target folder is inside dags/.
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=180
AIRFLOW__DAG_PROCESSOR__DAGBAG_IMPORT_TIMEOUT=180
#    Must stay GREATER than the import timeout above.
AIRFLOW__DAG_PROCESSOR__DAG_FILE_PROCESSOR_TIMEOUT=300

# 3) Never uncomment this line: a connection defined here OVERRIDES the one created in
#    the Airflow UI and hides it. The connections are created in the UI (see README).
# AIRFLOW_CONN_MSSQL_RAW=mssql://olist_ingest_login:password@host.docker.internal:1433/OlistDW

# 4) Only needed for "dbt by hand inside the container" (README, D3)
# DBT_USER=olist_dbt_login
# DBT_PASSWORD=change-me
